# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local backup script only (npm run backup) — never commit, never use in the app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: limit export to one user (UUID from Authentication → Users)
# BACKUP_USER_ID=your-user-uuid
